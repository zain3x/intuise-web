---
import LegacyLayout from "../../layouts/LegacyLayout.astro";
import productVisual from "../../assets/hero/frontimage.png";

const capabilities = [
  [
    "01",
    "Product design",
    "Shape complex requirements into understandable flows and interface decisions.",
    ["UX direction", "Interaction design", "Responsive UI"],
  ],
  [
    "02",
    "UX engineering",
    "Connect design intent with the constraints and behavior of the final interface.",
    ["Prototyping", "Design systems", "Frontend collaboration"],
  ],
  [
    "03",
    "Frontend",
    "Carry approved interface decisions into maintainable production-ready implementation.",
    ["Astro and React", "Accessibility", "Performance"],
  ],
];
const process = [
  [
    "01",
    "Understand",
    "Clarify the product, users, workflows, constraints, and evidence available.",
  ],
  [
    "02",
    "Shape",
    "Turn the problem into a focused direction and a coherent interface structure.",
  ],
  [
    "03",
    "Build",
    "Develop responsive screens while keeping design decisions close to the code.",
  ],
  [
    "04",
    "Review",
    "Validate the result, document the system, and prepare a practical handover.",
  ],
];
---

<LegacyLayout
  title="Intuise Legacy Visual Reference"
  description="A static visual reference preserving the previous Intuise website direction."
>
  <div class="legacy-root">
    <header class="legacy-header">
      <a
        class="legacy-brand"
        href="#legacy-top"
        aria-label="Intuise UX Solution"
        ><strong>Intuise</strong><span>UX Solution</span></a
      >
      <nav aria-label="Legacy reference navigation">
        <a href="#legacy-work">Work</a><a href="#legacy-services">Services</a><a
          href="#legacy-approach">Approach</a
        ><a href="#legacy-about">About</a><a
          class="legacy-nav-cta"
          href="#legacy-contact">Start a conversation</a
        >
      </nav>
      <details class="legacy-menu">
        <summary aria-label="Open menu"><i></i><i></i></summary><nav>
          <a href="#legacy-work">Work</a><a href="#legacy-services">Services</a
          ><a href="#legacy-approach">Approach</a><a href="#legacy-about"
            >About</a
          ><a href="#legacy-contact">Start a conversation</a>
        </nav>
      </details>
    </header>

    <main id="legacy-main">
      <section class="legacy-hero" id="legacy-top">
        <div class="legacy-hero-copy">
          <p class="legacy-eyebrow">
            Product design · UX engineering · Frontend
          </p><h1>Product experiences<br /><em>designed to be built.</em></h1><p
            class="legacy-intro"
          >
            Intuise turns complex product requirements into clear interfaces and
            carries the design through to responsive, production-ready frontend.
          </p><div class="legacy-actions">
            <a class="legacy-button legacy-button-signal" href="#legacy-work"
              >See selected work <span aria-hidden="true">↘</span></a
            ><a class="legacy-text-link" href="#legacy-services"
              >Explore capabilities →</a
            >
          </div>
        </div>
        <div class="legacy-hero-visual">
          <div class="legacy-visual-meta">
            <span>Selected interface work</span><span>01 / 02</span>
          </div><img
            src={productVisual.src}
            width={productVisual.width}
            height={productVisual.height}
            alt="Responsive interface concept shown across several devices"
          /><div class="legacy-visual-caption">
            <strong>Interface system</strong><span
              >Responsive product decisions shown as one connected composition.</span
            >
          </div>
        </div>
        <a class="legacy-scroll" href="#legacy-work"
          >Scroll to explore <i></i></a
        >
      </section>

      <section class="legacy-section legacy-light" id="legacy-work">
        <header class="legacy-section-heading">
          <div>
            <p class="legacy-eyebrow">Selected work</p><h2>
              Interfaces shaped around real operational complexity.
            </h2>
          </div><p>
            Two neutral examples preserve the earlier layout without exposing
            client-sensitive details or invented outcomes.
          </p>
        </header>
        <article class="legacy-project">
          <div class="legacy-project-media legacy-project-teal">
            <div class="legacy-interface-art">
              <i></i><i></i><i></i><i></i>
            </div><span>01 / 02</span>
          </div><div class="legacy-project-copy">
            <div class="legacy-tags">
              <span>Product interface</span><span>Operations</span>
            </div><h3>Operational interface</h3><p class="legacy-lead">
              A clearer working interface for a dense digital workflow.
            </p><p>
              This neutral reference preserves the scale, spacing, and hierarchy
              of the previous case-study treatment without publishing sensitive
              project material.
            </p><dl>
              <div><dt>Role</dt><dd>UI and interaction design</dd></div><div>
                <dt>Focus</dt><dd>Workflow clarity and maintainability</dd>
              </div>
            </dl>
          </div>
        </article>
        <article class="legacy-project legacy-project-reverse">
          <div class="legacy-project-media legacy-project-red">
            <div class="legacy-interface-art legacy-interface-web">
              <i></i><i></i><i></i><i></i>
            </div><span>02 / 02</span>
          </div><div class="legacy-project-copy">
            <div class="legacy-tags">
              <span>Company website</span><span>Content system</span>
            </div><h3>Structured website</h3><p class="legacy-lead">
              A public experience designed to make complex information easier to
              understand.
            </p><p>
              The composition retains the old project rhythm while using
              non-client content and neutral interface imagery.
            </p><dl>
              <div><dt>Role</dt><dd>Website and CMS experience</dd></div><div>
                <dt>Focus</dt><dd>Content structure and responsive UI</dd>
              </div>
            </dl>
          </div>
        </article>
      </section>

      <section class="legacy-section legacy-paper" id="legacy-services">
        <header class="legacy-section-heading">
          <div>
            <p class="legacy-eyebrow">What we help with</p><h2>
              Support where design and implementation need to meet.
            </h2>
          </div><p>
            Engage Intuise for a focused phase or a connected path from
            exploration through frontend delivery.
          </p>
        </header><div class="legacy-capabilities">
          {
            capabilities.map(([number, title, summary, items]) => (
              <article>
                <>
                  <span>{number}</span>
                  <h3>{title}</h3>
                  <p>{summary}</p>
                  <ul>
                    {(items as string[]).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section class="legacy-bridge">
        <p class="legacy-eyebrow">The advantage</p><div>
          <p>Design decisions that understand</p><div>
            <span>business requirements</span><i></i><span
              >frontend constraints</span
            >
          </div><p>before handoff becomes a problem.</p>
        </div>
      </section>

      <section class="legacy-section legacy-light" id="legacy-approach">
        <header class="legacy-section-heading">
          <div>
            <p class="legacy-eyebrow">How we work</p><h2>
              A practical process with fewer gaps between thinking and making.
            </h2>
          </div><p>
            Small-team collaboration keeps decisions direct. The process adapts
            to the product.
          </p>
        </header><ol class="legacy-process">
          {
            process.map(([number, title, body]) => (
              <li>
                <>
                  <span>{number}</span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="legacy-section legacy-paper legacy-about"
        id="legacy-about"
      >
        <aside>
          <p class="legacy-eyebrow">About Intuise</p><div
            class="legacy-angle"
            aria-hidden="true"
          >
            <span>90°</span>
          </div>
        </aside><div>
          <h2>
            A focused team for products that need both design judgement and
            implementation awareness.
          </h2><div class="legacy-about-columns">
            <p>
              Intuise works with founders, product teams, designers, and
              engineers to make complicated digital experiences easier to use
              and more realistic to build.
            </p><p>
              The small-team model keeps fewer layers between a requirement, a
              design decision, and the interface that ships.
            </p>
          </div><div class="legacy-fit">
            <span>Good fit for</span><ul>
              <li>Teams refining complex interfaces</li><li>
                Design teams needing UX engineering support
              </li><li>Businesses needing a credible website</li><li>
                Remote product collaboration
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="legacy-contact" id="legacy-contact">
        <p class="legacy-eyebrow">Start a conversation</p><h2>
          Have a product or interface that needs clearer thinking and stronger
          execution?
        </h2><p>
          Tell us what you are building, where the work is getting complicated,
          and what support your team needs.
        </p><a
          class="legacy-button legacy-button-dark"
          href="mailto:rindra@intuise.com?subject=Project%20discussion"
          >Discuss a project ↗</a
        ><div class="legacy-ruler" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => <i />)}
        </div>
      </section>
    </main>

    <footer class="legacy-footer">
      <div>
        <p class="legacy-eyebrow">Intuise UX Solution</p><strong
          >Clear interfaces. Thoughtful systems. Frontend that holds up.</strong
        >
      </div><div>
        <p>Jakarta, Indonesia · Working remotely</p><p>© 2026 Intuise</p>
      </div>
    </footer>
  </div>
</LegacyLayout>

<style>
  .legacy-root {
    --l-ink: #0b1110;
    --l-paper: #f3f1e9;
    --l-fog: #e8e7df;
    --l-signal: #12c3d0;
    --l-muted: #626a66;
    --l-muted-dark: #a6ada8;
    --l-line: rgba(11, 17, 16, 0.17);
    --l-line-dark: rgba(243, 241, 233, 0.2);
    background: var(--l-ink);
    color: var(--l-paper);
    font-family: "Inter", Arial, sans-serif;
    overflow-x: clip;
  }
  .legacy-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    min-height: 5rem;
    padding: 0 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--l-line-dark);
    background: color-mix(in srgb, var(--l-ink) 93%, transparent);
    backdrop-filter: blur(14px);
  }
  .legacy-brand {
    display: inline-grid;
    gap: 0.18rem;
    text-decoration: none;
    line-height: 1;
  }
  .legacy-brand strong {
    color: var(--l-paper);
    font:
      750 1.05rem/1 "Manrope",
      sans-serif;
  }
  .legacy-brand span {
    color: var(--l-muted-dark);
    font-size: 0.61rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }
  .legacy-header > nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }
  .legacy-header nav a {
    color: var(--l-muted-dark);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
  }
  .legacy-header nav a:hover {
    color: var(--l-paper);
  }
  .legacy-header .legacy-nav-cta {
    padding: 0.7rem 1rem;
    border: 1px solid var(--l-line-dark);
    color: var(--l-paper);
  }
  .legacy-menu {
    display: none;
  }
  .legacy-eyebrow {
    margin: 0;
    font-size: 0.67rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }
  .legacy-hero {
    min-height: 100svh;
    padding: clamp(8rem, 14vw, 11rem) 5vw 3rem;
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(26rem, 1.04fr);
    grid-template-rows: 1fr auto;
    gap: 5vw;
    position: relative;
    overflow: hidden;
    background: var(--l-ink);
  }
  .legacy-hero::before {
    content: "";
    position: absolute;
    inset: 5rem 5vw auto;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      var(--l-line-dark) 0 1px,
      transparent 1px 5vw
    );
  }
  .legacy-hero-copy {
    align-self: center;
    position: relative;
    z-index: 2;
  }
  .legacy-hero h1 {
    max-width: 11.5ch;
    margin: 1.2rem 0 1.8rem;
    font:
      650 clamp(3.3rem, 5.8vw, 6.25rem)/0.91 "Manrope",
      sans-serif;
    letter-spacing: -0.065em;
  }
  .legacy-hero h1 em {
    color: var(--l-signal);
    font-style: normal;
  }
  .legacy-intro {
    max-width: 38rem;
    margin: 0;
    color: var(--l-muted-dark);
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.65;
  }
  .legacy-actions {
    margin-top: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .legacy-button {
    min-height: 3.25rem;
    padding: 0.9rem 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    border: 1px solid transparent;
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }
  .legacy-button-signal {
    min-width: 13rem;
    background: var(--l-signal);
    color: var(--l-ink);
  }
  .legacy-button:hover {
    transform: translateY(-2px);
  }
  .legacy-text-link {
    font-size: 0.85rem;
    font-weight: 700;
    text-underline-offset: 0.35rem;
  }
  .legacy-hero-visual {
    width: min(100%, 42rem);
    min-height: min(68vh, 42rem);
    align-self: center;
    justify-self: end;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--l-line-dark);
    background:
      linear-gradient(180deg, rgba(11, 17, 16, 0.06), rgba(11, 17, 16, 0.88)),
      linear-gradient(90deg, rgba(11, 17, 16, 0.22), rgba(11, 17, 16, 0.02)),
      url("/assets/background.png") center/cover;
  }
  .legacy-hero-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        transparent 49.8%,
        rgba(255, 255, 255, 0.08) 50%,
        transparent 50.2%
      ),
      linear-gradient(
        transparent 49.8%,
        rgba(255, 255, 255, 0.08) 50%,
        transparent 50.2%
      );
    background-size: 5rem 5rem;
    opacity: 0.3;
  }
  .legacy-hero-visual img {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: -2%;
    width: min(84%, 35rem);
    height: auto;
    filter: drop-shadow(0 2rem 2.5rem rgba(0, 0, 0, 0.45));
  }
  .legacy-visual-meta,
  .legacy-visual-caption {
    position: absolute;
    z-index: 3;
    right: 1.25rem;
    left: 1.25rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .legacy-visual-meta {
    top: 1.15rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .legacy-visual-caption {
    bottom: 1.15rem;
    align-items: end;
  }
  .legacy-visual-caption strong {
    font:
      700 1.15rem "Manrope",
      sans-serif;
  }
  .legacy-visual-caption span {
    max-width: 14rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: right;
  }
  .legacy-scroll {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--l-muted-dark);
    font-size: 0.67rem;
    letter-spacing: 0.17em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .legacy-scroll i {
    width: 5rem;
    height: 1px;
    background: var(--l-line-dark);
  }
  .legacy-section {
    padding: clamp(5.5rem, 10vw, 10rem) 5vw;
    color: var(--l-ink);
  }
  .legacy-light {
    background: var(--l-fog);
  }
  .legacy-paper {
    background: var(--l-paper);
  }
  .legacy-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
    gap: 6vw;
    align-items: end;
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }
  .legacy-section-heading h2,
  .legacy-about h2 {
    max-width: 16ch;
    margin: 1rem 0 0;
    font:
      620 clamp(2.6rem, 5vw, 5.4rem)/0.98 "Manrope",
      sans-serif;
    letter-spacing: -0.055em;
  }
  .legacy-section-heading > p {
    max-width: 31rem;
    margin: 0;
    color: var(--l-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .legacy-project {
    min-height: 42rem;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(22rem, 0.88fr);
    border-top: 1px solid var(--l-line);
  }
  .legacy-project + .legacy-project {
    margin-top: clamp(4rem, 8vw, 8rem);
  }
  .legacy-project-reverse {
    grid-template-columns: minmax(22rem, 0.88fr) minmax(0, 1.12fr);
  }
  .legacy-project-reverse .legacy-project-media {
    order: 2;
  }
  .legacy-project-media {
    min-height: 38rem;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .legacy-project-media::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 4rem 4rem;
  }
  .legacy-project-teal {
    background: #17211f;
  }
  .legacy-project-red {
    background: #5f161d;
  }
  .legacy-project-media > span {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    color: rgba(255, 255, 255, 0.65);
    font: 600 0.65rem monospace;
    letter-spacing: 0.12em;
  }
  .legacy-interface-art {
    width: min(72%, 31rem);
    aspect-ratio: 16/10;
    padding: 1.5rem;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-content: end;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(145deg, #111c1b, #263a36);
    box-shadow: 0 2rem 3rem rgba(0, 0, 0, 0.35);
  }
  .legacy-interface-art::before {
    content: "";
    position: absolute;
    inset: 1.5rem 1.5rem auto;
    height: 42%;
    background: linear-gradient(
      135deg,
      rgba(18, 195, 208, 0.3),
      rgba(199, 79, 138, 0.15)
    );
  }
  .legacy-interface-art i {
    height: 6rem;
    background: rgba(255, 255, 255, 0.09);
  }
  .legacy-interface-web {
    background: linear-gradient(145deg, #35171a, #79202a);
  }
  .legacy-project-copy {
    padding: clamp(2rem, 5vw, 5rem);
    align-self: center;
  }
  .legacy-tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .legacy-tags span {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--l-line);
    color: var(--l-muted);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .legacy-project-copy h3 {
    margin: 1.8rem 0 1rem;
    font:
      650 clamp(2.7rem, 5vw, 5rem)/0.95 "Manrope",
      sans-serif;
    letter-spacing: -0.055em;
  }
  .legacy-project-copy p {
    max-width: 34rem;
    color: var(--l-muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .legacy-project-copy .legacy-lead {
    max-width: 27rem;
    color: var(--l-ink);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.4;
  }
  .legacy-project-copy dl {
    margin: 2.2rem 0 0;
    border-top: 1px solid var(--l-line);
  }
  .legacy-project-copy dl div {
    padding: 0.9rem 0;
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--l-line);
  }
  .legacy-project-copy dt,
  .legacy-project-copy dd {
    margin: 0;
    font-size: 0.72rem;
  }
  .legacy-project-copy dt {
    color: var(--l-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .legacy-capabilities {
    border-top: 1px solid var(--l-line);
  }
  .legacy-capabilities article {
    min-height: 15rem;
    padding: 2rem 0;
    display: grid;
    grid-template-columns:
      5rem minmax(14rem, 0.65fr) minmax(17rem, 0.75fr)
      minmax(14rem, 0.6fr);
    gap: 2rem;
    border-bottom: 1px solid var(--l-line);
  }
  .legacy-capabilities article > span {
    color: var(--l-muted);
    font: 600 0.68rem monospace;
  }
  .legacy-capabilities h3 {
    margin: 0;
    font:
      630 clamp(1.6rem, 2.8vw, 2.8rem)/1 "Manrope",
      sans-serif;
    letter-spacing: -0.04em;
  }
  .legacy-capabilities p {
    margin: 0;
    color: var(--l-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .legacy-capabilities ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legacy-capabilities li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--l-line);
    font-size: 0.72rem;
  }
  .legacy-bridge {
    min-height: 70svh;
    padding: clamp(5rem, 9vw, 9rem) 5vw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--l-ink);
    overflow: hidden;
  }
  .legacy-bridge > div {
    margin-top: 5rem;
  }
  .legacy-bridge > div > p {
    margin: 0;
    font:
      620 clamp(2.4rem, 5.9vw, 6.4rem)/1 "Manrope",
      sans-serif;
    letter-spacing: -0.055em;
  }
  .legacy-bridge > div > div {
    margin: 1.2rem 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
