---
type VisualRole = "primary" | "editor" | "overview";

interface ProjectImage {
  src: string;
  width: number;
  height: number;
  alt: string;
  role: VisualRole;
}

interface Props {
  title: string;
  metadata: string;
  description: string;
  capabilities: string[];
  images: ProjectImage[];
  index: string;
  eyebrow: string;
  featured?: boolean;
  reverse?: boolean;
  href?: string;
  linkLabel?: string;
}

const {
  title,
  metadata,
  description,
  capabilities,
  images,
  index,
  eyebrow,
  featured = false,
  reverse = false,
  href,
  linkLabel,
} = Astro.props;
---

<article
  class:list={[
    "case-study",
    { "case-study-featured": featured, "case-study-reverse": reverse },
  ]}
>
  <div
    class:list={[
      "case-visual",
      featured ? "case-visual-logistics" : "case-visual-operations",
    ]}
  >
    <span class="case-index">{index}</span>
    {
      images.map((image) => (
        <figure
          class:list={["interface-frame", `interface-frame-${image.role}`]}
        >
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>

  <div class="case-content">
    <p class="eyebrow">{eyebrow}</p>
    <p class="case-metadata">{metadata}</p>
    <h3>{title}</h3>
    <p class="case-description">{description}</p>
    <ul class="case-capabilities" aria-label={`${title} capabilities`}>
      {capabilities.map((capability) => <li>{capability}</li>)}
    </ul>
    {
      href && linkLabel && (
        <a class="text-link dark-link" href={href}>
          {linkLabel} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    border-top: 1px solid var(--border-light);
  }

  .case-study + .case-study {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .case-study-reverse {
    grid-template-columns: minmax(20rem, 0.86fr) minmax(0, 1.14fr);
  }

  .case-study-reverse .case-visual {
    grid-column: 2;
  }

  .case-study-reverse .case-content {
    grid-column: 1;
    grid-row: 1;
  }

  .case-visual {
    position: relative;
    min-width: 0;
    min-height: 30rem;
    overflow: hidden;
    background: var(--ink);
  }

  .case-study-featured .case-visual {
    min-height: 36rem;
  }

  .case-index {
    position: absolute;
    z-index: 4;
    top: 1.25rem;
    right: 1.25rem;
    color: var(--text-on-dark);
    font-family: monospace;
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
  }

  .interface-frame {
    margin: 0;
  }

  .interface-frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .case-visual-logistics {
    display: grid;
    place-items: center;
    background:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      url("/assets/background.png") center / cover;
    background-size:
      4rem 4rem,
      4rem 4rem,
      cover;
  }

  .case-visual-logistics .interface-frame-primary {
    width: min(68%, 24rem);
  }

  .case-visual-logistics img {
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2rem 2.5rem rgba(0, 0, 0, 0.5));
  }

  .case-visual-operations {
    background:
      linear-gradient(rgba(19, 198, 212, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(19, 198, 212, 0.1) 1px, transparent 1px),
      linear-gradient(145deg, #10211e, #081210 68%);
    background-size:
      3rem 3rem,
      3rem 3rem,
      cover;
  }

  .case-visual-operations::before {
    content: "Content operations / selected interface views";
    position: absolute;
    z-index: 3;
    left: 1.25rem;
    bottom: 1rem;
    color: var(--brand-primary-soft);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .interface-frame-editor {
    position: absolute;
    inset: 10% 6% 17% 7%;
    border: 1px solid rgba(245, 243, 235, 0.2);
    background: #111b19;
    box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.38);
  }

  .interface-frame-editor img {
    object-fit: contain;
  }

  .interface-frame-editor::after {
    content: "";
    position: absolute;
    top: 11.5%;
    left: 12.2%;
    width: 8%;
    height: 4%;
    background: rgba(32, 41, 47, 0.88);
    backdrop-filter: blur(5px);
  }

  .interface-frame-overview {
    position: absolute;
    z-index: 2;
    right: 3%;
    bottom: 7%;
    width: 34%;
    height: 39%;
    overflow: hidden;
    border: 1px solid rgba(245, 243, 235, 0.3);
    background: #0b1412;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.48);
  }

  .interface-frame-overview img {
    object-fit: cover;
    object-position: center 52%;
    transform: scale(1.08);
  }

  .interface-frame-overview::before,
  .interface-frame-overview::after {
    content: "";
    position: absolute;
    z-index: 1;
    background: rgba(35, 45, 47, 0.9);
    backdrop-filter: blur(5px);
  }

  .interface-frame-overview::before {
    top: 1.5%;
    left: 4%;
    width: 25%;
    height: 7%;
  }

  .interface-frame-overview::after {
    top: 31%;
    left: 16%;
    width: 20%;
    height: 7%;
  }

  .case-content {
    align-self: center;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .case-study:not(.case-study-featured) .case-content {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .case-metadata {
    margin: 1.25rem 0 0;
    color: var(--brand-primary-deep);
    font-size: var(--type-label);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .case-study-featured h3 {
    font-size: clamp(2rem, 3.4vw, 3.5rem);
  }

  .case-description {
    max-width: 42rem;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .case-capabilities {
    margin: 2rem 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .case-capabilities li {
    padding: 0.65rem 0.9rem 0.65rem 0;
    margin-right: 0.9rem;
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: 1.35;
  }

  .case-capabilities li::before {
    content: "—";
    margin-right: 0.45rem;
    color: var(--brand-primary-deep);
  }

  @media (max-width: 960px) {
    .case-study,
    .case-study-reverse {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    }

    .case-visual,
    .case-study-featured .case-visual {
      min-height: 27rem;
    }

    .case-content {
      padding: clamp(2rem, 4vw, 3rem);
    }
  }

  @media (max-width: 760px) {
    .case-study,
    .case-study-reverse {
      grid-template-columns: 1fr;
    }

    .case-study-reverse .case-visual,
    .case-study-reverse .case-content {
      grid-column: 1;
    }

    .case-study-reverse .case-visual {
      grid-row: 1;
    }

    .case-study-reverse .case-content {
      grid-row: 2;
    }

    .case-visual,
    .case-study-featured .case-visual {
      min-height: clamp(19rem, 82vw, 27rem);
    }

    .case-content {
      padding-inline: 0;
      padding-bottom: 0;
    }

    .case-study + .case-study {
      margin-top: 5rem;
    }

    .case-visual-operations::before {
      max-width: 55%;
    }
  }

  @media (max-width: 430px) {
    .interface-frame-editor {
      inset: 12% 3% 20%;
    }

    .interface-frame-overview {
      right: 3%;
      bottom: 8%;
      width: 42%;
      height: 37%;
    }

    .case-capabilities li {
      flex: 1 1 45%;
      margin-right: 0;
    }
  }
</style>
