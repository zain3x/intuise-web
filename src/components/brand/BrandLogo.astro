---
interface Props {
  inverted?: boolean;
  compact?: boolean;
}
const { inverted = false, compact = false } = Astro.props;
---

<span
  class:list={["brand-logo", { inverted, compact }]}
  aria-label="Intuise UX Solution"
>
  <strong>{compact ? "Intuise" : "INTUISE"}</strong>
  <small>UX Solution</small>
</span>

<style>
  .brand-logo {
    display: inline-grid;
    gap: 0.12rem;
    color: var(--brand-primary);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .brand-logo strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
  }
  .brand-logo small {
    color: var(--text-muted-dark);
    font-size: 0.57rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .brand-logo.inverted strong {
    color: var(--surface-paper);
  }
  .brand-logo.compact {
    gap: 0.04rem;
    letter-spacing: 0;
  }
  .brand-logo.compact strong {
    color: var(--brand-primary);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
    text-transform: none;
  }
  .brand-logo.compact small {
    color: var(--text-muted-dark);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
  }
</style>
