---
interface Props {
  concept: number;
  size?: "large" | "small";
  accent?: "core" | "ux" | "games";
  label?: string;
}

const {
  concept,
  size = "large",
  accent = "core",
  label = `Intuise logo concept ${concept}`,
} = Astro.props;
---

<svg
  class:list={["logo-concept-mark", size, accent]}
  viewBox="0 0 64 64"
  role="img"
  aria-label={label}
>
  {
    concept === 1 && (
      <>
        <path class="mark-main" d="M8 32 23 9h13L21 32l15 23H23z" />
        <path class="mark-accent" d="M56 32 41 9H28l15 23-15 23h13z" />
      </>
    )
  }
  {
    concept === 2 && (
      <>
        <path
          class="mark-line"
          d="M10 32c0-11 8-19 18-19 14 0 18 19 27 19 5 0 7-4 7-8s-3-8-8-8c-10 0-14 32-28 32-9 0-16-7-16-16Z"
        />
        <circle class="mark-accent" cx="32" cy="32" r="4" />
      </>
    )
  }
  {
    concept === 3 && (
      <>
        <rect class="mark-main" x="27" y="23" width="10" height="31" rx="5" />
        <circle class="mark-accent" cx="32" cy="12" r="6" />
        <path
          class="mark-line"
          d="M16 31a18 18 0 0 0 0 25M48 31a18 18 0 0 1 0 25"
        />
      </>
    )
  }
  {
    concept === 4 && (
      <>
        <path class="mark-main" d="M8 8h48v48H40V24H24v32H8z" />
        <rect class="mark-accent" x="27" y="29" width="10" height="27" rx="5" />
        <circle class="mark-accent" cx="32" cy="18" r="5" />
      </>
    )
  }
  {
    concept === 5 && (
      <>
        <circle class="mark-line" cx="32" cy="32" r="20" />
        <path
          class="mark-line"
          d="M9 39c9 9 29 10 42 1 8-5 8-12 2-16-7-5-24-3-34 3"
        />
        <circle class="mark-accent" cx="49" cy="18" r="6" />
      </>
    )
  }
  {
    concept === 6 && (
      <>
        <rect class="mark-main" x="8" y="8" width="21" height="21" rx="5" />
        <rect
          class="mark-accent"
          x="35"
          y="8"
          width="21"
          height="21"
          rx="10.5"
        />
        <rect
          class="mark-accent"
          x="8"
          y="35"
          width="21"
          height="21"
          rx="10.5"
        />
        <path class="mark-main" d="M35 35h21v21H35z" />
      </>
    )
  }
  {
    concept === 7 && (
      <>
        <path class="mark-main" d="m7 13 25-6 25 6-25 17z" />
        <path class="mark-accent" d="m7 13 25 17v27L14 43z" />
        <path class="mark-main muted" d="m57 13-25 17v27l18-14z" />
      </>
    )
  }
  {
    concept === 8 && (
      <>
        <path class="mark-line" d="M32 7v50M7 32h50M14 14l36 36M50 14 14 50" />
        <circle class="mark-main" cx="32" cy="32" r="10" />
        <circle class="mark-accent" cx="32" cy="32" r="4" />
      </>
    )
  }
  {
    concept === 9 && (
      <>
        <path class="mark-main" d="M8 11h48v36H31L18 57V47H8z" />
        <rect class="mark-cut" x="27" y="25" width="10" height="17" rx="5" />
        <circle class="mark-accent" cx="32" cy="19" r="5" />
      </>
    )
  }
  {
    concept === 10 && (
      <>
        <path class="mark-main" d="M9 8h46v11H9zM9 45h46v11H9z" />
        <path class="mark-accent" d="M21 20h22L32 32l11 12H21l11-12z" />
      </>
    )
  }
</svg>

<style>
  .logo-concept-mark {
    display: block;
    overflow: visible;
  }
  .logo-concept-mark.large {
    width: clamp(4.5rem, 9vw, 7rem);
    height: clamp(4.5rem, 9vw, 7rem);
  }
  .logo-concept-mark.small {
    width: 1.5rem;
    height: 1.5rem;
  }
  .mark-main {
    fill: currentColor;
  }
  .mark-main.muted {
    opacity: 0.68;
  }
  .mark-accent {
    fill: var(--mark-accent, var(--brand-primary-deep));
  }
  .mark-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark-cut {
    fill: var(--logo-surface, var(--surface-raised));
  }
  .core {
    --mark-accent: var(--brand-primary-deep);
  }
  .ux {
    --mark-accent: var(--brand-primary-deep);
  }
  .games {
    --mark-accent: var(--brand-accent-violet);
  }
</style>
