---
interface Props {
  variant?: "primary" | "secondary" | "text" | "ghost" | "icon" | "destructive";
  href?: string;
  disabled?: boolean;
  loading?: boolean;
  label?: string;
  external?: boolean;
}

const {
  variant = "primary",
  href,
  disabled = false,
  loading = false,
  label,
  external = false,
} = Astro.props;
const className = `ui-button ui-button--${variant}`;
const content = loading ? "Loading…" : label;
---

{
  href ? (
    <a
      class={className}
      href={disabled ? undefined : href}
      aria-disabled={disabled ? "true" : undefined}
      aria-busy={loading ? "true" : undefined}
      tabindex={disabled ? -1 : undefined}
      target={external ? "_blank" : undefined}
      rel={external ? "noreferrer" : undefined}
    >
      {loading && <span class="ui-button__spinner" aria-hidden="true" />}
      <slot>{content}</slot>
    </a>
  ) : (
    <button
      class={className}
      type="button"
      disabled={disabled || loading}
      aria-busy={loading ? "true" : undefined}
    >
      {loading && <span class="ui-button__spinner" aria-hidden="true" />}
      <slot>{content}</slot>
    </button>
  )
}
